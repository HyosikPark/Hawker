# 32-byte hex key for encrypting sellers' upstream API keys (AES-256-GCM)
# generate: openssl rand -hex 32
HAWKER_MASTER_KEY=

# --- x402 (에이전트 자율 결제) ---
# stub: 로컬 개발 — "X-PAYMENT: test" 허용, 정산 생략
# facilitator: 실검증/정산 (verify → settle)
HAWKER_X402_MODE=stub
HAWKER_X402_NETWORK=base-sepolia            # base(메인넷) | base-sepolia(테스트넷)
HAWKER_X402_FACILITATOR_URL=                # 예: https://x402.org/facilitator (테스트넷)
HAWKER_PAYTO_ADDRESS=0x0000000000000000000000000000000000000000  # 플랫폼 USDC 수취 주소

# --- Stripe (선불 크레딧 충전) --- 미설정 시 기능 비활성(503)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
HAWKER_TOPUP_SUCCESS_URL=
HAWKER_TOPUP_CANCEL_URL=

# Gateway port (402 = HTTP Payment Required)
PORT=8402

# Optional: override SQLite path
# HAWKER_DB_PATH=
